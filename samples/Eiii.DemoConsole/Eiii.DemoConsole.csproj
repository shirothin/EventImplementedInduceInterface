<Project Sdk="Microsoft.NET.Sdk">

  <!-- 人間が操作して Eiii の動作を観察するデモ。架空の XPort 系機器を模擬する。外部 UI ライブラリは使わない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Eiii.DemoConsole</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eiii.Comm\Eiii.Comm.csproj" />
  </ItemGroup>

</Project>
