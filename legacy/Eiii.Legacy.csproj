<Project Sdk="Microsoft.NET.Sdk">

  <!-- 原型（2018 年版。このフォルダーの *.cs）をそのままビルドするためのプロジェクト。原型のソースは変更しない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EventImplementedInduceInterface</AssemblyName>
