<Project Sdk="Microsoft.NET.Sdk">

  <!-- 原型（ルート直下の *.cs）をそのままビルドするためのプロジェクト。ソースはリンク参照のみ。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EventImplementedInduceInterface</AssemblyName>
    <RootNamespace>EventImplementedInduceInterface</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\*.cs" />
  </ItemGroup>

</Project>
